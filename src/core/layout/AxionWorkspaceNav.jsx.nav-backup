import React from "react";

const modules = [
{ id: "gestao", label: "AXION Gestão", initialView: "overview" },
{ id: "crm", label: "AXION CRM", initialView: "opportunities" },
{ id: "catalogo", label: "AXION Catálogo", initialView: "products" }
];

export default function AxionWorkspaceNav({
activeModule,
setActiveModule,
activeView,
setActiveView,
visibleNavigation,
currentView,
viewDescriptions
}) {
return (
<> <nav aria-label="Módulos AXION" className="axion-workspace-switcher">
{modules.map((item) => (
<button
key={item.id}
type="button"
aria-current={activeModule === item.id ? "page" : undefined}
onClick={() => {
setActiveModule(item.id);
setActiveView(item.initialView);
}}
>
{item.label} </button>
))} </nav> <nav className="analytics-nav" aria-label="Áreas do módulo atual">
{visibleNavigation.map((item) => (
<button
key={item.id}
type="button"
className={activeView === item.id ? "active" : ""}
onClick={() => setActiveView(item.id)}
>
{item.icon}<span>{item.label}</span>{item.badge ? <b>{item.badge}</b> : null} </button>
))} </nav> <section className="analytics-view-head"> <div><span>Área atual</span><h2>{currentView.label}</h2></div> <p>{viewDescriptions[activeView]}</p> </section>
</>
);
}